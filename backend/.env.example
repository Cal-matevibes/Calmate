# Generate each key locally; never commit actual secrets.
GOOGLE_OAUTH_SETUP_KEY=replace-with-at-least-32-random-characters
GMAIL_TOKEN_ENCRYPTION_KEY=replace-with-64-hexadecimal-characters

# Existing backend configuration
FRONTEND_URL=http://localhost:3000
