# Gmail API OAuth credentials. Store real values only in the backend environment.
GOOGLE_OAUTH_CLIENT_ID=your-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://cal-mate.onrender.com/api/email/google/callback
